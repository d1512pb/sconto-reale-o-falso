# Copiar a .env (que está en .gitignore) y completar. Nunca subir .env.

# Contacto que aparece en el user-agent (honesto, académico). Ej.: correo institucional o URL del repo.
SCONTO_CONTACTO=

# Mercado Libre Developers (app gratuita; registrar solo con aprobación del equipo)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=
# Se llenan solos tras la autorización inicial; el refresh se hace automáticamente
ML_REFRESH_TOKEN=

# INEGI BIE (token gratuito con registro en inegi.org.mx)
INEGI_TOKEN=
